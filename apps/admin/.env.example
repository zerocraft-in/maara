# Maara Merch - Admin environment variables
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and must never be committed.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only Supabase service role
SUPABASE_SECRET_KEY=

# SMTP (Gmail) - used only server-side for invitation emails
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Maara Merch

# Cloudflare R2 - media storage (custom domain: cdn.maara.co.in)
# Create an R2 bucket named `maara`, generate a bucket-scoped API token, and
# add a custom domain (CNAME cdn.maara.co.in → your R2 bucket domain) in
# Cloudflare. All new public asset keys must start with `assets/`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=maara
R2_CUSTOM_DOMAIN=https://cdn.maara.co.in