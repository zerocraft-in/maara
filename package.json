{
  "name": "maara-merch",
  "version": "0.1.0",
  "private": true,
  "description": "Maara Merch — clothing retail management SaaS (admin application)",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @maara/admin dev",
    "build": "pnpm --filter @maara/admin build",
    "start": "pnpm --filter @maara/admin start",
    "lint": "pnpm --filter @maara/admin lint",
    "typecheck": "pnpm --filter @maara/admin typecheck",
    "test": "pnpm --filter @maara/admin test",
    "test:e2e": "pnpm --filter @maara/admin test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff"
  },
  "devDependencies": {
    "supabase": "3.1.0"
  }
}
